# Puerto del servidor
PORT=3000

# Dirección del frontend (para permitir sus peticiones)
FRONTEND_URL=http://localhost:5173

# Ruta opcional a una clave de cuenta de servicio. Si no se define, se usa
# backend/firebase-key.json. No subas nunca esa clave al repositorio.
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\segura\firebase-key.json

# --- Biblioteca: los catálogos externos (servicio de Node) ---
# La búsqueda en Google Books y Open Library la atiende `backend-node/`, que
# es un servicio aparte. Es la única parte del campus que no tiene datos
# propios, y por eso puede vivir en otro proceso.
#
# Si no está levantado, el campus funciona igual: lo único que no se puede es
# buscar en catálogos externos, y la pantalla lo avisa.
# CATALOGOS_URL=http://127.0.0.1:4000

# El secreto compartido con ese servicio. Solo hace falta si allá se definió
# CLAVE_INTERNA, y entonces tiene que ser el mismo valor.
# CATALOGOS_CLAVE=

# OJO: GOOGLE_BOOKS_API_KEY ya no va acá. Ahora la usa el servicio de Node,
# que es el único que consulta Google: va en `backend-node/.env`.

# Tamaño máximo de los archivos que se suben a la biblioteca, en MB
# BIBLIOTECA_MAX_MB=15

# Viene en "no": sin token no se entra. En "si", quien llegue sin token entra
# como el usuario de prueba de datos_iniciales.json, que es administrador.
# Sirve para desarrollar; en la facultad tiene que quedar en "no".
PERMITIR_USUARIO_SIN_TOKEN=no

# --- Cloudflare R2: dónde viven los archivos del campus ---
# Reemplaza a Firebase Storage. R2 no cobra por sacar los datos, que para un
# campus que sirve apuntes todo el día es la diferencia que importa.
# Se saca de Cloudflare → R2 → "Manage R2 API Tokens".
# Sin esto el campus funciona igual, pero los archivos quedan en memoria y se
# pierden al reiniciar.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=campustfi
# Opcional: si no se define, se arma con R2_ACCOUNT_ID
# R2_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com

# Tamaño máximo de cualquier archivo que se suba, en MB
# ARCHIVOS_MAX_MB=15

# Lo que puede pesar una imagen: el avatar, el adjunto de un mensaje y la
# portada de una novedad. Un solo tope para las tres.
# IMAGENES_MAX_MB=10

# Lo más grande que puede llegar una petición entera, en MB. Tiene que entrar
# la subida más pesada (20 MB) más lo que agrega el base64.
# PETICION_MAX_MB=30

# Los frenos por minuto y por sesión. Son contra el abuso: quien usa el campus
# normalmente no los toca.
# PETICIONES_ESCRITURA_POR_MINUTO=120
# PETICIONES_LECTURA_POR_MINUTO=600

# Cuántos meses del registro de auditoría se cargan en memoria. 0 = todos.
# Lo que queda afuera **sigue entero en Firestore**; la pantalla avisa desde
# cuándo tiene datos.
# AUDITORIA_MESES_EN_MEMORIA=0

# Entrar sin iniciar sesión, como el usuario de prueba. Viene apagado: solo
# para desarrollar. Encendido, cualquiera entra como esa persona.
# PERMITIR_USUARIO_SIN_TOKEN=no

# El servidor de desarrollo se reinicia solo al guardar un archivo. En la
# facultad va en "no". Y HOST solo si hace falta publicarlo.
# RECARGA_AUTOMATICA=si
# HOST=127.0.0.1

# --- Firestore ---
# En "no", el campus trabaja solo en memoria y no guarda nada. Sirve para
# desarrollar sin tocar la base de la facultad.
# FIRESTORE_ACTIVO=si

# Firma las direcciones de las fotos de perfil y de los adjuntos. Si falta, se
# genera una nueva en cada arranque y las direcciones ya entregadas dejan de
# servir: los avatares dan 404 hasta recargar la pantalla.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# FIRMA_FOTOS=

# --- Django (la migración de FastAPI a Django) ---
# Mientras la lista de módulos migrados de `despachador.py` esté vacía, Django
# ni se carga y estas tres no hacen nada. Ninguna es obligatoria para
# desarrollar.

# Django no arranca sin una. El campus no la usa para nada —sin sesiones, ni
# CSRF, ni firmas de Django—, así que si falta se sortea una al arrancar. En
# producción conviene fijarla igual.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# Apagado salvo que diga "si". NUNCA en "si" en producción: con DEBUG un error
# muestra la traza y la configuración en la respuesta.
# DJANGO_DEBUG=no

# Separados por comas. Con un host que no esté en la lista, Django contesta 400
# a todo: al publicar el campus hay que agregar el dominio de verdad.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
