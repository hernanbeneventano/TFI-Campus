# Puerto del servidor
PORT=3000

# Dirección del frontend (para permitir sus peticiones)
FRONTEND_URL=http://localhost:5173

# Ruta opcional a una clave de cuenta de servicio. Si no se define, se usa
# backend/firebase-key.json. No subas nunca esa clave al repositorio.
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\segura\firebase-key.json

# --- Inicio de sesión ---
# Mientras se desarrolla conviene poder usar el campus sin loguearse: si no
# llega token, el servidor responde como el usuario de prueba de datos.py.
#
# En producción esto tiene que estar en "no" sin excepción: con "si",
# cualquiera que llegue sin token entra como esa persona. Si no se define,
# vale "si", que es lo cómodo para desarrollar y lo peligroso para publicar.
PERMITIR_USUARIO_SIN_TOKEN=no

# --- Biblioteca ---
# Google Books se puede consultar sin clave, pero el límite por IP es bajo y
# devuelve 429 enseguida. Con una clave propia el cupo es mucho mayor:
# https://console.cloud.google.com/apis/library/books.googleapis.com
# Queda en el backend a propósito: nunca va al navegador.
# GOOGLE_BOOKS_API_KEY=

# Tamaño máximo de los archivos que se suben a la biblioteca, en MB
# BIBLIOTECA_MAX_MB=15
