# Puerto del servidor
PORT=3000

# Dirección del frontend (para permitir las peticiones)
FRONTEND_URL=http://localhost:5173

# Base de datos: a definir
# DATABASE_URL=

# --- Biblioteca ---
# Google Books se puede consultar sin clave, pero el límite por IP es bajo y
# devuelve 429 enseguida. Con una clave propia el cupo es mucho mayor:
# https://console.cloud.google.com/apis/library/books.googleapis.com
# Queda en el backend a propósito: nunca va al navegador.
# GOOGLE_BOOKS_API_KEY=

# Tamaño máximo de los archivos que se suben a la biblioteca, en MB
# BIBLIOTECA_MAX_MB=15
