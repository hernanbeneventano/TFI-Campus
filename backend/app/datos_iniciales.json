 "temasForo": [
  {
   "id": 1,
   "cursoId": 1,
   "titulo": "¿Cómo encaran el punto 3 del TP 3?",
   "autorId": 3,
   "fecha": {
    "__fecha": "haceHoras",
    "n": 30
   },
   "mensajes": [
    {
     "id": 1,
     "autorId": 3,
     "texto": "Llegué a armar la lista pero me trabo al borrar el nodo del medio. ¿Guardan el anterior en una variable o se fijan con un segundo puntero?",
     "fecha": {
      "__fecha": "haceHoras",
      "n": 30
     }
    },
    {
     "id": 2,
     "autorId": 4,
     "texto": "Yo uso dos punteros, uno que va adelante y otro atrás. Cuando el de adelante encuentra el nodo, el de atrás ya quedó apuntando al anterior.",
     "fecha": {
      "__fecha": "haceHoras",
      "n": 27
     },
     "votos": [
      1,
      5,
      6
     ]
    },
    {
     "id": 3,
     "autorId": 2,
     "texto": "Las dos formas están bien. Si hacen la lista doblemente enlazada ni siquiera necesitan el segundo puntero, porque cada nodo ya conoce al anterior.",
     "fecha": {
      "__fecha": "haceHoras",
      "n": 25
     },
     "votos": [
      1,
      3,
      4,
      6
     ]
    }
   ]
  },
  {
   "id": 2,
   "cursoId": 1,
   "titulo": "Error en el ejemplo de Fibonacci del apunte",
   "autorId": 5,
   "fecha": {
    "__fecha": "haceHoras",
    "n": 70
   },
   "mensajes": [
    {
     "id": 4,
     "autorId": 5,
