# ===== El servicio de catálogos externos =====
# Este servicio no guarda nada del campus: ni personas, ni materias, ni
# materiales. Solo consulta catálogos públicos. Por eso no necesita las claves
# de Firebase ni las de R2, y no hay que dárselas.

# Puerto propio. El campus (Python) le pega acá.
PUERTO=4000

# Se publica solo en la máquina. El navegador nunca le habla directo: le habla
# al campus, y el campus le habla a este servicio. Dejarlo en 127.0.0.1 es lo
# que impide que quede expuesto sin querer.
HOST=127.0.0.1

# Secreto compartido con el campus. Si se define acá, hay que definir el mismo
# CATALOGOS_CLAVE en backend/.env, o el campus recibe 401.
# Vacío en desarrollo: con HOST en 127.0.0.1 no llega nadie de afuera.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CLAVE_INTERNA=

# Google Books se puede consultar sin clave, pero el cupo por IP es bajo y
# devuelve 429 casi siempre. Es la misma clave que figuraba en backend/.env:
# ahora va acá, porque este es el único que consulta Google.
# GOOGLE_BOOKS_API_KEY=

# Cuánto se espera a cada catálogo, en segundos. Medido contra Open Library,
# que ronda los 4 s.
# ESPERA_SEGUNDOS=9

# Cuántos resultados se piden a cada catálogo.
# POR_FUENTE=20

# La caché: cuánto vive cada búsqueda y cuántas se guardan.
# CACHE_SEGUNDOS=600
# CACHE_MAXIMO=200

# Freno propio del servicio, por ventana de un minuto. Es contra el abuso y
# contra gastar el cupo de Google: el campus ya tiene su propio freno por
# persona, este es el de último recurso.
# FRENO_POR_MINUTO=120
